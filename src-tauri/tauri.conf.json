{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "minilearn",
  "version": "0.1.0",
  "identifier": "com.aniruddhapisolkar.minilearn",
  "build": {
    "beforeDevCommand": "node scripts/prepare-tauri-assets.mjs",
    "beforeBuildCommand": "node scripts/prepare-tauri-assets.mjs",
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Education",
    "shortDescription": "A quiet, local-first learning workspace.",
    "longDescription": "minilearn is a quiet, local-first learning workspace with a knowledge map, guided tutoring, and portable .learn archives.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
